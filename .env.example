# Data source: "mock" (default, no credentials needed) or "maxmanager"
DATA_PROVIDER=mock   # set to "maxmanager" for real data

# Server-side cache duration for menu data, in seconds
CACHE_TTL_SECONDS=900

# Timeout for each upstream request, in milliseconds
REQUEST_TIMEOUT_MS=10000

# --- MaxManager (only used when DATA_PROVIDER=maxmanager) ---
MAXMANAGER_BASE_URL=https://sws2.maxmanager.xyz

# Number of weeks (Mon–Fri) to fetch, starting with the current week
MAXMANAGER_WEEKS=2

# Optional override of the location list, "id:Name,id:Name".
# If empty, locations are read from the #listbox-locations select on index.php?mode=bed
# e.g. MAXMANAGER_LOCATION_IDS=4:Location A,16:Location B
MAXMANAGER_LOCATION_IDS=
